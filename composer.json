{
    "name": "hostkurd/flocms",
    "description": "FloCMS is a light weight PHP Framework Developed by HostKurd",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "HostKurd\\Flocms\\Controllers\\": "controllers/",
            "HostKurd\\Flocms\\Models\\": "models/"
        }
    },
    "authors": [
        {
            "name": "HostKurd"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "hostkurd/flocms-core": "@dev",
        "samayo/bulletproof": "5.0.*"
    },
    "repositories": [
        {
        "type": "vcs",
        "url": "https://github.com/hostkurd/flocms-core"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "HostKurd\\Flocms\\Tests\\": "tests/"
        }
    }
}
