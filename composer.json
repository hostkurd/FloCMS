{
  "name": "hostkurd/flocms",
  "description": "FloCMS is a light weight PHP Framework Developed by HostKurd",
  "type": "project",
  "license": "MIT",

  "autoload": {
    "psr-4": {
      "FloCMS\\Controllers\\": "controllers/",
      "FloCMS\\Models\\": "models/",
      "FloCMS\\Support\\": "support/",
      "App\\Api\\": "api/",
      "App\\Commands\\": "commands/"
    }
  },

  "authors": [
    {
      "name": "HostKurd"
    }
  ],

  "minimum-stability": "stable",
  "prefer-stable": true,

  "require": {
    "php": "^8.1",
    "hostkurd/flocms-core": "2.2.0",
    "hostkurd/flocms-cli": "2.0.0",
    "hostkurd/flocms-uploader": "1.2.0",
    "hostkurd/flocms-captcha": "^1.0",
    "hostkurd/flocms-api": "1.2.0"
  },

  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php -r \"is_dir('storage') || mkdir('storage', 0755);\"",
      "@php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0755, true);\"",
      "@php flo key:generate"
    ],
    "test": "phpunit"
  },

  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },

  "autoload-dev": {
    "psr-4": {
      "HostKurd\\Flocms\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    }
  }
}
