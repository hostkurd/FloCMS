APP_NAME=FloCMS
APP_VERSION=1.7.2
APP_ENV=local
APP_KEY=
APP_URL=http://localhost
API_URL=https://flocms.com/api/

# Template
APP_TEMPLATE=default

# General Settings
SITE_NAME=FLO CMS
SITE_NAME_ADMIN=FLO CMS ADMIN PANEL
PRIMARY_EMAIL=info@flocms.com

# Multilingual Settings
LANGUAGES=en,ar,ku
DEFAULT_LANG=en

# Database Configuration
# Leave DB_NAME empty until you have created a database (e.g. in phpMyAdmin).
# XAMPP default: DB_USERNAME=root with an empty DB_PASSWORD.
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Dev Mode
APP_DEBUG=true
# Reverse proxies (IPs/CIDR, comma separated) whose X-Forwarded-For is trusted
TRUSTED_PROXIES=

# API (public/api.php)
# CORS origins, comma separated; one-label wildcards allowed (https://*.example.com)
API_CORS_ORIGINS=
# Requests per minute per client
API_RATE_LIMIT=60
# IPs/CIDR ranges that can use the API while the site is in maintenance mode
API_MAINTENANCE_ALLOWED_IPS=
# Legacy /api/<controller>/<action> route (no CSRF, no auth). Leave false for new sites.
LEGACY_API=false
